#!/bin/bash

# Stop on error
set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Push into that directory
pushd "$SCRIPT_DIR" >/dev/null

# Package list, and the current host (lowercase, to match section names)
PKG_FILE="$SCRIPT_DIR/../pkgs/packages.ini"
HOST="$(hostname | tr '[:upper:]' '[:lower:]')"

# Print all packages for a manager ("pacman" or "flatpak") that apply to
# "any" plus the current host
collect_pkgs() {
	local manager="$1" section="" line
	local -a out=()

	while IFS= read -r line || [[ -n "$line" ]]; do
		line="${line%%#*}"                      # strip comment
		line="${line#"${line%%[![:space:]]*}"}" # trim leading whitespace
		line="${line%"${line##*[![:space:]]}"}" # trim trailing whitespace
		[[ -z "$line" ]] && continue

		if [[ "$line" =~ ^\[([^]]+)\]$ ]]; then
			section="${BASH_REMATCH[1],,}"
		elif [[ "$section" == "$manager.any" || "$section" == "$manager.$HOST" ]]; then
			out+=("$line")
		fi
	done <"$PKG_FILE"

	[[ ${#out[@]} -gt 0 ]] && printf '%s\n' "${out[@]}"
	return 0
}

# If no argument is provided, run all tasks
RUN_ALL=false
if [ $# -eq 0 ]; then
	RUN_ALL=true
fi

# Help
if [ "$1" = "--help" ]; then
	echo "dotnet"
	echo "firmware"
	echo "flatpak"
	echo "nvim"
	echo "pkgs_inst"
	echo "pkgs_upd"
	echo "tldr"
	echo "yay"
fi

# Yay
#
if $RUN_ALL || [ "$1" = "yay" ]; then
	echo "#########################################"
	echo "# Installing Yay"
	echo "#########################################"

	# Check if yay is installed
	if command -v yay &>/dev/null; then
		echo "yay is already installed."
	else
		echo "yay not found. Installing yay..."

		# Temporary working directory
		TEMP_DIR=$(mktemp -d)

		# Cleanup on exit
		cleanup() {
			echo "Cleaning up..."
			rm -rf "$TEMP_DIR"
		}
		trap cleanup EXIT

		# Clone yay from AUR
		git clone https://aur.archlinux.org/yay.git "$TEMP_DIR/yay"

		# Build and install
		cd "$TEMP_DIR/yay"
		makepkg -si --noconfirm

		echo "yay installed successfully."
	fi
fi

#
# Yay Packages (update)
#
if $RUN_ALL || [ "$1" = "pkgs_upd" ]; then
	echo "#########################################"
	echo "# Updating packages"
	echo "#########################################"

	# Update database
	yay -Syy

	# Update installed packages
	yay -Syu --noconfirm
fi

#
# Yay Packages (install)
#
if $RUN_ALL || [ "$1" = "pkgs_inst" ]; then
	echo "#########################################"
	echo "# Installing packages"
	echo "#########################################"

	# Update database
	yay -Syy

	mapfile -t packages < <(collect_pkgs pacman)
	if [[ ${#packages[@]} -gt 0 ]]; then
		echo "Installing pacman packages: ${packages[*]}"
		yay -S --needed --noconfirm "${packages[@]}"
	else
		echo "No pacman packages for host '$HOST'."
	fi
fi

#
# DotNet
#
if $RUN_ALL || [ "$1" = "dotnet" ]; then
	echo "#########################################"
	echo "# Install .Net"
	echo "#########################################"

	# URL to download
	URL="https://builds.dotnet.microsoft.com/dotnet/scripts/v1/dotnet-install.sh"

	# Extract the filename from the URL
	FILENAME=$(basename "$URL")

	# Check if the file already exists
	if [ -f "$FILENAME" ]; then
		echo "File '$FILENAME' already exists. Skipping download."
	else
		# Download dotnet-install.sh
		wget -O $FILENAME $URL
		chmod +x $FILENAME
	fi

	# Also part of pkgs.txt, but just to be sure
	yay -S --needed --noconfirm dotnet-host

	sudo ./dotnet-install.sh --install-dir /usr/share/dotnet --channel 8.0
	sudo ./dotnet-install.sh --install-dir /usr/share/dotnet --channel 9.0
	sudo ./dotnet-install.sh --install-dir /usr/share/dotnet --channel 10.0

	dotnet tool install --global csharpier
	dotnet tool install --global dotnet-counters
	dotnet tool install --global dotnet-dump
	dotnet tool install --global dotnet-sos
	dotnet tool install --global dotnet-suggest
	dotnet tool install --global dotnet-symbol
	dotnet tool install --global easydotnet
	dotnet tool install --global ilspycmd
	dotnet tool install --global roslynator.dotnet.cli
	# dotnet tool update --global --all --ignore-failed-sources

	sudo dotnet workload update
fi

#
# Flatpak
#
if $RUN_ALL || [ "$1" = "flatpak" ]; then
	echo "#########################################"
	echo "# Updating Flatpak packages"
	echo "#########################################"

	if ! command -v flatpak &>/dev/null; then
		echo "flatpak is not installed. Skipping."
	else
		# Update packages
		flatpak update --system --assumeyes
		flatpak update --user --assumeyes

		mapfile -t packages < <(collect_pkgs flatpak)
		if [[ ${#packages[@]} -gt 0 ]]; then
			echo "Installing flatpak packages: ${packages[*]}"
			flatpak install --system --assumeyes --or-update "${packages[@]}"
		else
			echo "No flatpak packages for host '$HOST'."
		fi
	fi
fi

#
# Neovim
#
if $RUN_ALL || [ "$1" = "nvim" ]; then
	echo "#########################################"
	echo "Updating Neovim plugins"
	echo "#########################################"
	nvim --headless "+Lazy update" +qa
fi

#
# Firmware
#
if $RUN_ALL || [ "$1" = "firmware" ]; then
	echo "#########################################"
	echo "Updating firmware"
	echo "#########################################"
	fwupdmgr refresh
	fwupdmgr get-updates
fi

#
# TLDR
#
if $RUN_ALL || [ "$1" = "tldr" ]; then
	echo "#########################################"
	echo "Updating TLDR"
	echo "#########################################"
	tldr --update
fi

# Pop back to the original directory
popd >/dev/null
